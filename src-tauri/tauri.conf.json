{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CastRoom AI",
  "mainBinaryName": "CastRoom AI",
  "version": "0.1.4",
  "identifier": "com.castroom.ai.v013",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CastRoom AI",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*",
          "$RESOURCE/**/*",
          "../character-packs/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/app/icon-32.png",
      "../assets/app/icon-128.png",
      "../assets/app/icon-256.png",
      "../assets/app/icon.ico"
    ],
    "resources": [
      "../character-packs/README.md",
      "../character-packs/.gitkeep",
      "../resources/models/chat/**/*",
      "../resources/runners/llama.cpp/**/*",
      "../resources/runners/whisper.cpp/**/*"
    ]
  }
}
